	      <a
	        class="btn btn-ghost gh"
	        href={`https://github.com/${REPO}`}
	        aria-label={
	          starLabel
	            ? `Smart Second Brain on GitHub — ${stars!.toLocaleString('en-US')} stars`
	            : 'Smart Second Brain on GitHub'
	        }
	      >
