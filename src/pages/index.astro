---
import '../styles/landing.css';

const title = 'Smart Second Brain \u2014 Your vault, but smarter';
/*
  Kept under ~150 characters: Google truncates a meta description around there,
  and social cards clip earlier still on mobile. The long form ("watch them
  sort themselves into topics, all powered by AI you choose") said the same
  three things in 171 and lost its tail in every preview.
*/
const description =
	'A free, open-source Obsidian plugin. Chat with your notes, see them grouped by topic, search by meaning. Runs fully offline.';

const REPO = 's2b-dev/smart-second-brain';

/*
  The share image is a committed PNG rendered by scripts/og-image.mjs, not a
  per-page generation — one image for every share of every page. The docs
  point at the same file through `starlight.head` in astro.config.mjs (this
  page bypasses Starlight, so the tag has to be repeated here; keep the two
  URLs identical). `twitter:card` was already `summary_large_image`, which
  without an image rendered every share as a bare link.
*/
const ogAlt =
	'Your vault, but smarter. A free, open-source Obsidian plugin. Chat with your notes, see them grouped by topic, search by meaning.';

/*
  Both install links key off the plugin id from manifest.json, not the repo
  name. (The community registry's `repo` field still points at the pre-rename
  your-papa/obsidian-Smart2Brain — an update has been requested; GitHub
  redirects cover it meanwhile, and nothing here depends on it.)

  `obsidian://` opens the in-app plugin page. It is a no-op when Obsidian is
  not installed, so every use of it must be paired with the community-page
  fallback below.
*/
const PLUGIN_ID = 'smart-second-brain';
const OBSIDIAN_URI = `obsidian://show-plugin?id=${PLUGIN_ID}`;
const COMMUNITY_URL = `https://community.obsidian.md/plugins/${PLUGIN_ID}`;

/*
  Star count is fetched at build time \u2014 the site redeploys on every push, so it
  stays close enough, and visitors pay no request for it. The unauthenticated
  API allows 60 requests/hour per IP; if that runs out (or CI is offline) the
  build must still succeed, so failure just drops the count from the button.
*/
async function fetchStars(): Promise<number | null> {
	try {
		const res = await fetch(`https://api.github.com/repos/${REPO}`, {
			headers: { Accept: 'application/vnd.github+json' },
			signal: AbortSignal.timeout(5000),
		});
		if (!res.ok) throw new Error(`GitHub API responded ${res.status}`);
		const data = await res.json();
		return typeof data.stargazers_count === 'number' ? data.stargazers_count : null;
	} catch (err) {
		console.warn(`[landing] star count unavailable: ${(err as Error).message}`);
		return null;
	}
}

const stars = await fetchStars();
const starLabel =
	stars === null
		? null
		: stars >= 1000
			? (stars / 1000).toFixed(1).replace(/\.0$/, '') + 'k'
			: String(stars);

/*
  Structured data. This is how crawlers and answer engines learn that the site
  is *about a free open-source Obsidian plugin* rather than a SaaS landing
  page — the prose says so, but only to a reader.

  Deliberately omitted: `softwareVersion` and `applicationSubCategory`. The
  version is in the plugin's manifest.json and would become one more
  hand-maintained fact that drifts between releases (the site has a checklist
  for those already, and this is not worth adding to it). What is here is
  either stable (MIT, free, the two URLs) or derived from constants above, so
  editing the description or the plugin id updates the markup with it.

  `price: '0'` with `AGGREGATE` omitted is the correct shape for genuinely
  free software: an Offer with a zero price, not a missing Offer. Verified
  against the plugin's LICENSE (MIT) and manifest.json (isDesktopOnly: false,
  hence both desktop and mobile in operatingSystem; `author` is the manifest's
  two names, not an invented organisation). The category is UtilitiesApplication
  — schema.org has no "editor plugin" value, and BrowserApplication, the
  nearest-sounding one, would claim it runs in a browser.
*/
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Smart Second Brain',
	description,
	applicationCategory: 'UtilitiesApplication',
	operatingSystem: 'Obsidian (Windows, macOS, Linux, iOS, Android)',
	url: 'https://smartsecondbrain.dev/',
	downloadUrl: COMMUNITY_URL,
	license: 'https://opensource.org/licenses/MIT',
	isAccessibleForFree: true,
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
	author: [
		{ '@type': 'Person', name: 'Leo310' },
		{ '@type': 'Person', name: 'nicobrauchtgit' },
	],
	sameAs: [`https://github.com/${REPO}`, COMMUNITY_URL],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href="https://smartsecondbrain.dev/" />

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

		<meta property="og:type" content="website" />
		<!-- Starlight emits this on every docs page; this page bypasses it. Without
		     it Discord and Slack render the card with no source above the title. -->
		<meta property="og:site_name" content="Smart Second Brain" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://smartsecondbrain.dev/" />
		<meta property="og:image" content="https://smartsecondbrain.dev/og.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="https://smartsecondbrain.dev/og.png" />

		{/* set:html, not interpolation — Astro HTML-escapes `{...}` in element
		    content, which would turn the JSON's quotes into &quot; and leave
		    crawlers with an unparseable block. */}
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		{/* Inter is self-hosted from /public/fonts — see the @font-face block at
		    the top of landing.css for why (Google Fonts transferred visitor IPs
		    to Google, which LG München I 3 O 17493/20 made expensive). No
		    preconnect is needed any more: the files are same-origin.

		    Body text is 400; preloading it means the first paint of the hero
		    copy does not wait for the CSS to be parsed before the font request
		    starts. The other weights are discovered normally — they are used
		    below the fold or in short runs, where a swap is not noticeable. */}
		<link
			rel="preload"
			href="/fonts/inter-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		{/*
		  Must run before first paint so the wrong theme never flashes. Reads the
		  same 'starlight-theme' key the docs use, so the choice carries across
		  the landing page and Starlight in both directions.
		*/}
		<script is:inline>
			(function () {
			  var stored = null;
			  try {
			    stored = localStorage.getItem('starlight-theme');
			  } catch (e) {
			    /* private mode — fall through to the OS preference */
			  }
			  var theme =
			    stored === 'light' || stored === 'dark'
			      ? stored
			      : window.matchMedia('(prefers-color-scheme: light)').matches
			        ? 'light'
			        : 'dark';
			  document.documentElement.dataset.theme = theme;
			})();
		</script>

		{/* Analytics, and the one case where they must NOT load.

		    Umami's heatmap viewer does not show a stored snapshot — it iframes
		    the LIVE page, sized to the recorded full-page height (~6700px), and
		    draws clicks over it. That has two consequences this script handles:

		    1. Inside that frame, 100dvh is the frame height, so the hero
		       (`min-height: calc(100dvh - 58px)`) swallows the entire frame and
		       every later section is clipped away. Open upstream as
		       umami-software/umami#4373, unfixed as of 3.3.1. The `framed`
		       class set here lets landing.css give the hero a fixed height in
		       that case. Set pre-paint so the frame never lays out tall first.
		    2. The framed page would otherwise load these very scripts, and each
		       viewing of the heatmap would record a pageview plus scroll rows
		       with viewport_h ≈ 6700 into the dataset it is displaying. Nothing
		       legitimately embeds this site, so framed ⇒ do not measure.

		    The tags are injected rather than static so that gating is possible;
		    dynamically inserted scripts are async, so this still never blocks
		    paint. Umami's tracker reads its website id off
		    `document.currentScript`, which is set for injected classic scripts.
		    Both ids are public by design. The docs pages get the same gate via
		    `starlight.head` in astro.config.mjs (tracker + beacon, no recorder). */}
		<script is:inline>
			(function () {
			  var framed = false;
			  try { framed = window.self !== window.top; } catch (e) { framed = true; }
			  if (framed) { document.documentElement.classList.add('framed'); return; }
			  function add(attrs) {
			    var s = document.createElement('script');
			    for (var k in attrs) s.setAttribute(k, attrs[k]);
			    document.head.appendChild(s);
			  }
			  /* Cloudflare Web Analytics: cookieless, kept as a second opinion
			     while the self-hosted instance proves itself. */
			  add({
			    type: 'module',
			    src: 'https://static.cloudflareinsights.com/beacon.min.js',
			    'data-cf-beacon': '{"token": "303916a95994415190ed79caf5046bde"}'
			  });
			  /* Umami: unique visitors and the CTA events (`data-umami-event`). */
			  add({
			    defer: '',
			    src: 'https://analytics.smartsecondbrain.dev/script.js',
			    'data-website-id': 'e178beda-ae04-4f1e-9ac6-3620bfc1107b'
			  });
			  /* Umami's recorder, for heatmaps only — replays are a separate flag
			     and stay off. rrweb at ~190KB, so landing page only. */
			  add({
			    defer: '',
			    src: 'https://analytics.smartsecondbrain.dev/recorder.js',
			    'data-website-id': 'e178beda-ae04-4f1e-9ac6-3620bfc1107b'
			  });
			})();
		</script>

		{/* Must run before first paint so the intro does not flash. Skipped when
		    framed (see above): the intro's 22vh travel would be ~1500px inside
		    the heatmap frame, and nobody is watching. */}
		<script is:inline>
			(function () {
			  if (document.documentElement.classList.contains('framed')) return;
			  try {
			    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			    if (sessionStorage.getItem('s2b-intro-seen') === '1') return;
			    sessionStorage.setItem('s2b-intro-seen', '1');
			  } catch (e) {
			    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			  }
			  document.documentElement.classList.add('intro-on');
			})();
		</script>

		{/* Analytics tags are injected by the gate script above, not written
		    here — see its comment for why. Disclosed in the footer below. */}
	</head>

	<body>
