---
import '../styles/landing.css';

const title = 'Smart Second Brain \u2014 Your vault, but smarter';
const description =
	'A free, open-source Obsidian plugin: smarter search, an interactive knowledge graph, and an AI agent that reads your notes before it answers.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href="https://smartsecondbrain.dev/" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://smartsecondbrain.dev/" />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		{/* Must run before first paint so the intro does not flash. */}
		<script is:inline>
			(function () {
			  try {
			    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			    if (sessionStorage.getItem('s2b-intro-seen') === '1') return;
			    sessionStorage.setItem('s2b-intro-seen', '1');
			  } catch (e) {
			    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			  }
			  document.documentElement.classList.add('intro-on');
			})();
		</script>
	</head>

	<body>
	<nav>
	  <div class="wrap nav-inner">
	    <a class="brand" href="#">
	      <svg viewBox="0 0 39 11" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
	        <path d="M0.255127 10.8804V8.92945L8.88443 8.94446C9.32465 8.94446 9.65981 8.84441 9.88993 8.64431C10.13 8.4342 10.2501 8.09904 10.2501 7.63881C10.2501 7.17858 10.13 6.84841 9.88993 6.64831C9.65981 6.43821 9.32465 6.33316 8.88443 6.33316H3.51175C2.4012 6.33316 1.53577 6.06802 0.915456 5.53776C0.305152 4.99749 0 4.2071 0 3.16658C0 2.12606 0.305152 1.34067 0.915456 0.810404C1.53577 0.270135 2.4012 0 3.51175 0H11.946V1.95097L3.76688 1.93596C3.33666 1.93596 3.0015 2.03601 2.76138 2.23611C2.52126 2.42621 2.4012 2.73636 2.4012 3.16658C2.4012 3.59679 2.52126 3.91195 2.76138 4.11205C3.0015 4.30214 3.33666 4.39719 3.76688 4.39719H9.13955C10.2501 4.39719 11.1105 4.67233 11.7208 5.2226C12.3411 5.76287 12.6513 6.56827 12.6513 7.63881C12.6513 8.69933 12.3411 9.50474 11.7208 10.055C11.1105 10.6053 10.2501 10.8804 9.13955 10.8804H0.255127Z"/>
	        <path d="M13.1523 10.7983V7.61676C13.1523 6.61626 13.4325 5.84088 13.9928 5.2906C14.553 4.74033 15.3684 4.46519 16.439 4.46519H21.3764C22.3269 4.46519 22.8022 4.05999 22.8022 3.24959C22.8022 2.43918 22.3269 2.03398 21.3764 2.03398H13.3925V0.0830078H21.8417C22.8822 0.0830078 23.6876 0.363147 24.2579 0.923426C24.8382 1.48371 25.1283 2.25909 25.1283 3.24959C25.1283 4.24008 24.8382 5.01547 24.2579 5.57574C23.6876 6.13602 22.8822 6.41616 21.8417 6.41616H16.7691C16.3389 6.41616 16.0138 6.52622 15.7937 6.74633C15.5836 6.95643 15.4785 7.25658 15.4785 7.64678V8.86238H24.8432V10.7983H13.1523Z"/>
	        <path d="M25.6289 10.8055V0.10521L34.6634 0.0751953C35.854 0.0751953 36.7344 0.32532 37.3047 0.825569C37.885 1.31581 38.1752 2.05618 38.1752 3.04668C38.1752 4.03717 37.845 4.76253 37.1847 5.22276C37.6249 5.46288 37.95 5.78304 38.1601 6.18324C38.3703 6.57343 38.4753 7.07868 38.4753 7.69899C38.4753 8.7095 38.1852 9.47988 37.6049 10.0101C37.0346 10.5304 36.1542 10.7905 34.9636 10.7905L25.6289 10.8055ZM34.3783 1.99615H28.0301V4.39735H34.3783C35.2887 4.39735 35.7439 3.98715 35.7439 3.16674C35.7439 2.38635 35.2887 1.99615 34.3783 1.99615ZM34.6784 6.31831H28.0301V8.86958H34.6784C35.5889 8.86958 36.0441 8.43936 36.0441 7.57893C36.0441 6.73852 35.5889 6.31831 34.6784 6.31831Z"/>
	      </svg>
	      <span class="brand-name">Smart Second Brain</span>
	    </a>
	    <div class="nav-links">
	      <a href="#search">Search</a>
	      <a href="#privacy">Privacy</a>
	      <a href="#agent">Agent</a>
	      <a href="#start">Install</a>
	<a href="/start/installation/">Docs</a>
	    </div>
	    <a class="btn btn-ghost" href="https://github.com/s2b-dev/smart-second-brain">GitHub</a>
	  </div>
	</nav>

	<header class="hero">
	  <canvas id="graph" aria-hidden="true"></canvas>
	  <div class="hero-mask"></div>

	  <div class="hero-content">
	    <div class="logo-lockup">
	      <svg viewBox="0 0 39 11" xmlns="http://www.w3.org/2000/svg" aria-label="Smart Second Brain">
	        <path d="M0.255127 10.8804V8.92945L8.88443 8.94446C9.32465 8.94446 9.65981 8.84441 9.88993 8.64431C10.13 8.4342 10.2501 8.09904 10.2501 7.63881C10.2501 7.17858 10.13 6.84841 9.88993 6.64831C9.65981 6.43821 9.32465 6.33316 8.88443 6.33316H3.51175C2.4012 6.33316 1.53577 6.06802 0.915456 5.53776C0.305152 4.99749 0 4.2071 0 3.16658C0 2.12606 0.305152 1.34067 0.915456 0.810404C1.53577 0.270135 2.4012 0 3.51175 0H11.946V1.95097L3.76688 1.93596C3.33666 1.93596 3.0015 2.03601 2.76138 2.23611C2.52126 2.42621 2.4012 2.73636 2.4012 3.16658C2.4012 3.59679 2.52126 3.91195 2.76138 4.11205C3.0015 4.30214 3.33666 4.39719 3.76688 4.39719H9.13955C10.2501 4.39719 11.1105 4.67233 11.7208 5.2226C12.3411 5.76287 12.6513 6.56827 12.6513 7.63881C12.6513 8.69933 12.3411 9.50474 11.7208 10.055C11.1105 10.6053 10.2501 10.8804 9.13955 10.8804H0.255127Z"/>
	        <path d="M13.1523 10.7983V7.61676C13.1523 6.61626 13.4325 5.84088 13.9928 5.2906C14.553 4.74033 15.3684 4.46519 16.439 4.46519H21.3764C22.3269 4.46519 22.8022 4.05999 22.8022 3.24959C22.8022 2.43918 22.3269 2.03398 21.3764 2.03398H13.3925V0.0830078H21.8417C22.8822 0.0830078 23.6876 0.363147 24.2579 0.923426C24.8382 1.48371 25.1283 2.25909 25.1283 3.24959C25.1283 4.24008 24.8382 5.01547 24.2579 5.57574C23.6876 6.13602 22.8822 6.41616 21.8417 6.41616H16.7691C16.3389 6.41616 16.0138 6.52622 15.7937 6.74633C15.5836 6.95643 15.4785 7.25658 15.4785 7.64678V8.86238H24.8432V10.7983H13.1523Z"/>
	        <path d="M25.6289 10.8055V0.10521L34.6634 0.0751953C35.854 0.0751953 36.7344 0.32532 37.3047 0.825569C37.885 1.31581 38.1752 2.05618 38.1752 3.04668C38.1752 4.03717 37.845 4.76253 37.1847 5.22276C37.6249 5.46288 37.95 5.78304 38.1601 6.18324C38.3703 6.57343 38.4753 7.07868 38.4753 7.69899C38.4753 8.7095 38.1852 9.47988 37.6049 10.0101C37.0346 10.5304 36.1542 10.7905 34.9636 10.7905L25.6289 10.8055ZM34.3783 1.99615H28.0301V4.39735H34.3783C35.2887 4.39735 35.7439 3.98715 35.7439 3.16674C35.7439 2.38635 35.2887 1.99615 34.3783 1.99615ZM34.6784 6.31831H28.0301V8.86958H34.6784C35.5889 8.86958 36.0441 8.43936 36.0441 7.57893C36.0441 6.73852 35.5889 6.31831 34.6784 6.31831Z"/>
	      </svg>
	    </div>

	    <div class="pill reveal" style="--d:2100ms"><span class="dot"></span>Free and open source</div>
	    <h1 class="reveal" style="--d:2180ms">Your vault,<br>but <span class="grad">smarter</span></h1>
	    <p class="lede reveal" style="--d:2260ms">
	      Better search, a graph that finds the topics hiding in your notes,
	      and an agent that reads them before it answers.
	    </p>
	    <div class="cta-row reveal" style="--d:2340ms">
	      <a class="btn btn-primary" href="#start">Install the plugin</a>
	      <a class="btn btn-ghost" href="https://github.com/s2b-dev/smart-second-brain">View source</a>
	    </div>
	    <p class="hero-note reveal" style="--d:2420ms">search + graph work with no AI provider</p>
	  </div>

	  <div class="graph-cap"><span class="lm">●</span> live: Leiden community detection over a sample vault</div>
	</header>

	<section id="search">
	  <div class="wrap">
	    <div class="sec-head">
	      <div class="eyebrow">// search</div>
	      <h2>Finds the note you meant</h2>
	      <p>Full-text, fuzzy, and tag-aware out of the box. Watch it rank as the query builds.</p>
	    </div>

	    <div class="demo">
	      <div class="demo-bar"><i></i><i></i><i></i><span>vault — smart search</span></div>
	      <div class="demo-body">
	        <div class="demo-tree" id="tree"></div>
	        <div class="demo-main">
	          <div class="search-box">
	            <span style="color:var(--text-3)">⌕</span>
	            <span id="typed"></span><span class="cursor"></span>
	          </div>
	          <div class="search-hint">tab toggles semantic · #tag and /folder filter · ⌥↵ asks the agent</div>
	          <div class="results" id="results"></div>
	        </div>
	      </div>
	    </div>
	  </div>
	</section>

	<section id="privacy" style="background:var(--bg-2); border-block:1px solid var(--border);">
	  <div class="wrap privacy-wrap">
	    <div>
	      <div class="eyebrow">// privacy</div>
	      <h2 style="text-align:left">Your notes stay yours</h2>
	      <p style="color:var(--text-2); font-size:16.5px; margin:12px 0 22px;">
	        Run a local model and nothing ever leaves your machine. Use a cloud one and you decide, per note, what it may see.
	      </p>
	      <div class="toggle-row">
	        <button class="tg on" data-mode="local">Local model</button>
	        <button class="tg" data-mode="cloud">Cloud provider</button>
	      </div>
	      <ul class="privacy-list">
	        <li><span class="ck">✓</span><span><strong>Untrusted by default.</strong> Cloud providers start blocked from every private note.</span></li>
	        <li><span class="ck">✓</span><span><strong>Private-by-default vaults.</strong> Only notes you allow can be read, embedded, or sent.</span></li>
	        <li><span class="ck">✓</span><span><strong>Staged edits.</strong> Nothing is written to disk until you approve the diff.</span></li>
	      </ul>
	    </div>

	    <div class="flow">
	      <div class="machine">
	        <span class="machine-label">your machine</span>
	        <div class="node-row">
	          <div class="fnode"><strong>vault</strong><span>1,284 notes</span></div>
	          <span class="arrow">→</span>
	          <div class="fnode"><strong>plugin</strong><span>index + agent</span></div>
	          <span class="arrow" id="arr2">→</span>
	          <div class="fnode" id="localModel"><strong>ollama</strong><span>local model</span></div>
	        </div>
	      </div>
	      <div class="cloud-zone">
	        <div class="barrier blocked" id="barrier">✕ nothing crosses this line</div>
	        <div class="cloud-node" id="cloudNode" style="opacity:.4">☁ cloud provider — idle</div>
	      </div>
	    </div>
	  </div>
	</section>

	<section id="agent">
	  <div class="wrap">
	    <div class="sec-head">
	      <div class="eyebrow">// agent</div>
	      <h2>It reads before it answers</h2>
	      <p>Searches your vault, opens what's relevant, and stages every edit for review.</p>
	    </div>
	    <div class="agent">
	      <div class="agent-head"><span style="color:var(--accent)">●</span> chat — project notes</div>
	      <div class="agent-body" id="agentBody"></div>
	    </div>
	  </div>
	</section>

	<section style="background:var(--bg-2); border-block:1px solid var(--border);">
	  <div class="wrap">
	    <div class="sec-head">
	      <div class="eyebrow">// everything else</div>
	      <h2>Built for daily use</h2>
	    </div>
	    <div class="fgrid">
	      <div class="fcell"><span class="k">memory</span><h4>It remembers you</h4><p>Opt in and the agent keeps its own notes on your preferences and projects — as real notes in your vault, yours to read and edit.</p></div>
	      <div class="fcell"><span class="k">skills</span><h4>Teach it your tools</h4><p>Bundled skills for exploring your vault, editing notes and searching the web. Write your own as plain notes.</p></div>
	      <div class="fcell"><span class="k">mcp</span><h4>Connect anything</h4><p>Attach MCP servers to give the agent any external tool or data source.</p></div>
	      <div class="fcell"><span class="k">.chat</span><h4>Branching history</h4><p>Chats are files in your vault. Editing a message forks a branch instead of erasing the old one.</p></div>
	      <div class="fcell"><span class="k">vision</span><h4>Images and PDFs</h4><p>Send them to models that support it — capability is detected per model, not assumed.</p></div>
	      <div class="fcell"><span class="k">subagents</span><h4>Delegate</h4><p>Hand focused work to another agent with its own model, tools and clean context.</p></div>
	      <div class="fcell"><span class="k">parallel</span><h4>Many chats at once</h4><p>Run several conversations simultaneously — none blocks another.</p></div>
	      <div class="fcell"><span class="k">pointers</span><h4>Never goes stale</h4><p>Memory stores links to where facts live in your vault, not copies — so answers reflect your current notes.</p></div>
	    </div>
	  </div>
	</section>

	<section id="start">
	  <div class="wrap">
	    <div class="sec-head">
	      <div class="eyebrow">// providers</div>
	      <h2>Bring your own model</h2>
	      <p>Six provider types. Multiple instances each. Switch per chat.</p>
	    </div>
	    <div class="provs">
	      <div class="prov">OpenAI</div>
	      <div class="prov">Anthropic</div>
	      <div class="prov">Ollama <em>local</em></div>
	      <div class="prov">oMLX <em>local</em></div>
	      <div class="prov">OpenRouter</div>
	      <div class="prov">OpenAI-compatible</div>
	    </div>
	  </div>
	</section>

	<section class="final" style="background:var(--bg-2); border-top:1px solid var(--border);">
	  <div class="wrap">
	    <h2>Make your second brain smarter</h2>
	    <p>Free, open source, private by design.</p>
	    <div class="cta-row">
	      <a class="btn btn-primary" href="https://github.com/s2b-dev/smart-second-brain">Get the plugin</a>
	      <a class="btn btn-ghost" href="https://github.com/s2b-dev/smart-second-brain#readme">Read the docs</a>
	    </div>
	  </div>
	</section>

	<footer>
	  <div class="wrap foot">
	    <p class="mono">MIT · Leo310 &amp; nicobrauchtgit</p>
	    <div>
	      <a href="https://github.com/s2b-dev/smart-second-brain">GitHub</a>
	      <a href="https://github.com/s2b-dev/smart-second-brain/issues">Issues</a>
	      <a href="https://obsidian.md">Obsidian</a>
	    </div>
	  </div>
	</footer>
		<script src="../scripts/landing.js"></script>
	</body>
</html>
