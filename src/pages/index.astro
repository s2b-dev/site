	      </svg>
	      <span class="brand-name">Smart Second Brain</span>
	    </a>
	    <div class="nav-links">
	      <a href="#demo">How it works</a>
	      <a href="#privacy">Privacy</a>
	      <a href="#start">Install</a>
	<a href="/start/installation/">Docs</a>
	    </div>
	    <div class="nav-right">
	      <button
	        class="theme-tg"
	        type="button"
	        aria-label="Toggle dark and light theme"
	        aria-pressed="false"
	      >
	        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
	          <circle cx="12" cy="12" r="4"></circle>
	          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
	        </svg>
	        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
	          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
	        </svg>
	      </button>
	      <a
	        class="btn btn-ghost gh"
	        href={`https://github.com/${REPO}`}
	        aria-label={
	          starLabel
	            ? `Smart Second Brain on GitHub — ${stars!.toLocaleString('en-US')} stars`
	            : 'Smart Second Brain on GitHub'
	        }
	      >
	        <svg class="gh-mark" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
	          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
	        </svg>
	        {
	          starLabel && (
	            <>
	              <span class="gh-sep" aria-hidden="true"></span>
	              <svg class="gh-star" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
	                <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
	              </svg>
	              <span class="gh-count mono">{starLabel}</span>
	            </>
	          )
	        }
	      </a>
	    </div>
	  </div>
	</nav>

	<header class="hero">
	  <canvas id="graph" aria-hidden="true"></canvas>
	  <div class="hero-mask"></div>

	  <div class="hero-content">
	    <div class="logo-lockup">
	      <svg viewBox="0 0 39 11" xmlns="http://www.w3.org/2000/svg" aria-label="Smart Second Brain">
	        <path d="M0.255127 10.8804V8.92945L8.88443 8.94446C9.32465 8.94446 9.65981 8.84441 9.88993 8.64431C10.13 8.4342 10.2501 8.09904 10.2501 7.63881C10.2501 7.17858 10.13 6.84841 9.88993 6.64831C9.65981 6.43821 9.32465 6.33316 8.88443 6.33316H3.51175C2.4012 6.33316 1.53577 6.06802 0.915456 5.53776C0.305152 4.99749 0 4.2071 0 3.16658C0 2.12606 0.305152 1.34067 0.915456 0.810404C1.53577 0.270135 2.4012 0 3.51175 0H11.946V1.95097L3.76688 1.93596C3.33666 1.93596 3.0015 2.03601 2.76138 2.23611C2.52126 2.42621 2.4012 2.73636 2.4012 3.16658C2.4012 3.59679 2.52126 3.91195 2.76138 4.11205C3.0015 4.30214 3.33666 4.39719 3.76688 4.39719H9.13955C10.2501 4.39719 11.1105 4.67233 11.7208 5.2226C12.3411 5.76287 12.6513 6.56827 12.6513 7.63881C12.6513 8.69933 12.3411 9.50474 11.7208 10.055C11.1105 10.6053 10.2501 10.8804 9.13955 10.8804H0.255127Z"/>
	        <path d="M13.1523 10.7983V7.61676C13.1523 6.61626 13.4325 5.84088 13.9928 5.2906C14.553 4.74033 15.3684 4.46519 16.439 4.46519H21.3764C22.3269 4.46519 22.8022 4.05999 22.8022 3.24959C22.8022 2.43918 22.3269 2.03398 21.3764 2.03398H13.3925V0.0830078H21.8417C22.8822 0.0830078 23.6876 0.363147 24.2579 0.923426C24.8382 1.48371 25.1283 2.25909 25.1283 3.24959C25.1283 4.24008 24.8382 5.01547 24.2579 5.57574C23.6876 6.13602 22.8822 6.41616 21.8417 6.41616H16.7691C16.3389 6.41616 16.0138 6.52622 15.7937 6.74633C15.5836 6.95643 15.4785 7.25658 15.4785 7.64678V8.86238H24.8432V10.7983H13.1523Z"/>
	        <path d="M25.6289 10.8055V0.10521L34.6634 0.0751953C35.854 0.0751953 36.7344 0.32532 37.3047 0.825569C37.885 1.31581 38.1752 2.05618 38.1752 3.04668C38.1752 4.03717 37.845 4.76253 37.1847 5.22276C37.6249 5.46288 37.95 5.78304 38.1601 6.18324C38.3703 6.57343 38.4753 7.07868 38.4753 7.69899C38.4753 8.7095 38.1852 9.47988 37.6049 10.0101C37.0346 10.5304 36.1542 10.7905 34.9636 10.7905L25.6289 10.8055ZM34.3783 1.99615H28.0301V4.39735H34.3783C35.2887 4.39735 35.7439 3.98715 35.7439 3.16674C35.7439 2.38635 35.2887 1.99615 34.3783 1.99615ZM34.6784 6.31831H28.0301V8.86958H34.6784C35.5889 8.86958 36.0441 8.43936 36.0441 7.57893C36.0441 6.73852 35.5889 6.31831 34.6784 6.31831Z"/>
	      </svg>
	    </div>

	    <div class="pill reveal" style="--d:2100ms"><span class="dot"></span>Free and open source</div>
	    <h1 class="reveal" style="--d:2180ms">Your vault,<br>but <span class="grad">smarter</span></h1>
	    <p class="lede reveal" style="--d:2260ms">
	      Better search, a graph that finds the topics hiding in your notes,
	      and an agent that reads them before it answers.
	    </p>
	    <div class="cta-row reveal" style="--d:2340ms">
	      <a class="btn btn-primary" href={OBSIDIAN_URI}>
	        	        {/* Obsidian's own icon (obsidian.md/favicon.svg) — the faceted
	            small-size mark, which stays legible where a flat silhouette does not. */}
